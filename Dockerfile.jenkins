# Lab 5: Custom Jenkins Docker Image
# Student: Srinivas Raghav V C
# Roll No: 2022BCS0016

FROM jenkins/jenkins:lts

USER root

# Install Python 3, pip, virtualenv
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    jq \
    bc \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Docker CLI
RUN curl -fsSL https://get.docker.com -o get-docker.sh && \
    sh get-docker.sh && \
    rm get-docker.sh

# Install Python packages
RUN pip3 install --no-cache-dir \
    pandas \
    numpy \
    scikit-learn \
    joblib \
    requests

USER jenkins

# Labels for identification
LABEL maintainer="2022BCS0016 - Srinivas Raghav V C"
LABEL description="Custom Jenkins image for MLOps Lab 5"
LABEL roll_no="2022BCS0016"
