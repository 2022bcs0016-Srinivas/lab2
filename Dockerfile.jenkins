# Lab 5: Custom Jenkins Docker Image
# Student: Srinivas Raghav V C
# Roll No: 2022BCS0016

FROM jenkins/jenkins:lts

USER root

# Install Python 3, pip, virtualenv, git, and helpers used in pipelines
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    jq \
    bc \
    curl \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Docker CLI
RUN curl -fsSL https://get.docker.com -o get-docker.sh && \
    sh get-docker.sh && \
    rm get-docker.sh

# Install Python packages used in the labs
RUN pip3 install --no-cache-dir \
    pandas \
    numpy \
    scikit-learn \
    joblib \
    requests

# Preinstall Jenkins plugins needed for Labs 5-7
RUN jenkins-plugin-cli --plugins \
    workflow-aggregator \
    git \
    docker-workflow \
    pipeline-utility-steps

USER jenkins

# Labels for identification
LABEL maintainer="2022BCS0016 - Srinivas Raghav V C"
LABEL description="Custom Jenkins image for MLOps Lab 5"
LABEL roll_no="2022BCS0016"
