// Lab 7: Jenkins Pipeline for Inference Validation
// Student: Srinivas Raghav V C
// Roll No: 2022BCS0016

pipeline {
    agent any

    environment {
        ROLL_NO = '2022BCS0016'
        STUDENT_NAME = 'Srinivas Raghav V C'
        DOCKER_IMAGE = '2022bcs0016srinivasraghavvc/wine-quality'
        CONTAINER_NAME = 'wine-quality-test'
        API_PORT = '8000'
    }

    stages {
        stage('Pull Image') {
            steps {
                echo "Roll No: ${ROLL_NO} - Pulling Docker image..."
                sh "docker pull ${DOCKER_IMAGE}:latest"
            }
        }

        stage('Run Container') {
            steps {
                echo "Roll No: ${ROLL_NO} - Starting container..."
                sh '''
                    docker rm -f ${CONTAINER_NAME} || true
                    docker run -d --name ${CONTAINER_NAME} ${DOCKER_IMAGE}:latest
                    echo "Container started: ${CONTAINER_NAME}"
                '''
            }
        }

        stage('Wait for Service Readiness') {
            steps {
                echo "Roll No: ${ROLL_NO} - Waiting for API to be ready..."
                script {
                    env.CONTAINER_IP = sh(
                        script: "docker inspect -f '{{range.NetworkSettings.Networks}}{{.IPAddress}}{{end}}' ${CONTAINER_NAME}",
                        returnStdout: true
                    ).trim()
                    env.API_BASE_URL = "http://${env.CONTAINER_IP}:8000"
                    echo "Container IP: ${env.CONTAINER_IP}"

                    def ready = false
                    def attempts = 0
                    def maxAttempts = 30

                    while (!ready && attempts < maxAttempts) {
                        try {
                            def response = sh(script: "curl -s -o /dev/null -w '%{http_code}' ${env.API_BASE_URL}/health || true", returnStdout: true).trim()
                            if (response == '200') {
                                ready = true
                                echo "API is ready!"
                            } else {
                                sleep(2)
                                attempts++
                            }
                        } catch (Exception e) {
                            sleep(2)
                            attempts++
                        }
                    }

                    if (!ready) {
                        error("API did not become ready within timeout")
                    }
                }
            }
        }

        stage('Send Valid Inference Request') {
            steps {
                echo "Roll No: ${ROLL_NO} - Testing valid prediction..."
                script {
                    def status = sh(
                        script: '''
                            curl -s -o valid_response.json -w "%{http_code}" \
                            -X POST "${API_BASE_URL}/predict" \
                            -H "Content-Type: application/json" \
                            --data @jenkins/valid_request.json
                        ''',
                        returnStdout: true
                    ).trim()

                    def response = readFile('valid_response.json')
                    echo "Valid response status: ${status}"
                    echo "Valid response body: ${response}"

                    if (status != '200') {
                        error("Expected HTTP 200 for valid inference request, got ${status}")
                    }

                    def payload = readJSON text: response
                    if (!payload.containsKey('wine_quality')) {
                        error("Invalid response format - missing wine_quality field")
                    }
                    if (payload.roll_no != ROLL_NO) {
                        error("Invalid response - unexpected roll number: ${payload.roll_no}")
                    }

                    if (!(payload.wine_quality instanceof Number)) {
                        error("Prediction value is not numeric: ${payload.wine_quality}")
                    }

                    echo "Valid inference test passed!"
                }
            }
        }

        stage('Send Invalid Request') {
            steps {
                echo "Roll No: ${ROLL_NO} - Testing error handling..."
                script {
                    def status = sh(
                        script: '''
                            curl -s -o invalid_response.json -w "%{http_code}" \
                            -X POST "${API_BASE_URL}/predict" \
                            -H "Content-Type: application/json" \
                            --data @jenkins/invalid_request.json
                        ''',
                        returnStdout: true
                    ).trim()

                    def response = readFile('invalid_response.json')
                    echo "Invalid response status: ${status}"
                    echo "Invalid response body: ${response}"

                    if (status.toInteger() < 400) {
                        error("Expected invalid request to fail, got HTTP ${status}")
                    }

                    def payload = readJSON text: response
                    if (!payload.containsKey('detail')) {
                        error("Invalid request did not return a meaningful error payload")
                    }

                    echo "Error handling test passed!"
                }
            }
        }

        stage('Stop Container') {
            steps {
                echo "Roll No: ${ROLL_NO} - Stopping container..."
                sh '''
                    docker stop ${CONTAINER_NAME} || true
                    docker rm ${CONTAINER_NAME} || true
                '''
            }
        }

        stage('Pipeline Result') {
            steps {
                echo "Roll No: ${ROLL_NO} - All tests passed successfully!"
                echo "Inference validation completed for 2022BCS0016"
            }
        }
    }

    post {
        always {
            echo "Roll No: ${ROLL_NO} - Cleaning up..."
            sh 'docker stop ${CONTAINER_NAME} || true'
            sh 'docker rm ${CONTAINER_NAME} || true'
        }
        success {
            echo "========================================"
            echo "Lab 7 - Inference Validation: PASSED"
            echo "Roll No: 2022BCS0016"
            echo "========================================"
        }
        failure {
            echo "========================================"
            echo "Lab 7 - Inference Validation: FAILED"
            echo "Roll No: 2022BCS0016"
            echo "========================================"
        }
    }
}
