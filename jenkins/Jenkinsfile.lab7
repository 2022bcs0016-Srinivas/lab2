// Lab 7: Jenkins Pipeline for Inference Validation
// Student: Srinivas Raghav V C
// Roll No: 2022BCS0016

pipeline {
    agent any
    
    environment {
        ROLL_NO = '2022BCS0016'
        STUDENT_NAME = 'Srinivas Raghav V C'
        DOCKER_IMAGE = '2022bcs0016srinivasraghavvc/wine-quality'
        CONTAINER_NAME = 'wine-quality-test'
        API_PORT = '8000'
    }
    
    stages {
        stage('Pull Image') {
            steps {
                echo "Roll No: ${ROLL_NO} - Pulling Docker image..."
                sh "docker pull ${DOCKER_IMAGE}:latest"
            }
        }
        
        stage('Run Container') {
            steps {
                echo "Roll No: ${ROLL_NO} - Starting container..."
                sh '''
                    docker run -d --name ${CONTAINER_NAME} -p ${API_PORT}:8000 ${DOCKER_IMAGE}:latest
                    echo "Container started: ${CONTAINER_NAME}"
                '''
            }
        }
        
        stage('Wait for Service Readiness') {
            steps {
                echo "Roll No: ${ROLL_NO} - Waiting for API to be ready..."
                script {
                    def ready = false
                    def attempts = 0
                    def maxAttempts = 30
                    
                    while (!ready && attempts < maxAttempts) {
                        try {
                            def response = sh(script: "curl -s -o /dev/null -w '%{http_code}' http://localhost:${API_PORT}/health || true", returnStdout: true).trim()
                            if (response == '200') {
                                ready = true
                                echo "API is ready!"
                            } else {
                                sleep(2)
                                attempts++
                            }
                        } catch (Exception e) {
                            sleep(2)
                            attempts++
                        }
                    }
                    
                    if (!ready) {
                        error("API did not become ready within timeout")
                    }
                }
            }
        }
        
        stage('Send Valid Inference Request') {
            steps {
                echo "Roll No: ${ROLL_NO} - Testing valid prediction..."
                script {
                    def response = sh(script: '''
                        curl -s -X POST "http://localhost:${API_PORT}/predict" \
                        -H "Content-Type: application/json" \
                        -d '{
                            "fixed_acidity": 7.4,
                            "volatile_acidity": 0.7,
                            "citric_acid": 0.0,
                            "residual_sugar": 1.9,
                            "chlorides": 0.076,
                            "free_sulfur_dioxide": 11.0,
                            "total_sulfur_dioxide": 34.0,
                            "density": 0.9978,
                            "pH": 3.51,
                            "sulphates": 0.56,
                            "alcohol": 9.4
                        }'
                    ''', returnStdout: true)
                    
                    echo "Response: ${response}"
                    
                    // Validate response
                    if (!response.contains('wine_quality')) {
                        error("Invalid response format - missing wine_quality field")
                    }
                    
                    if (!response.contains('2022BCS0016')) {
                        error("Invalid response - missing roll number")
                    }
                    
                    echo "Valid inference test passed!"
                }
            }
        }
        
        stage('Send Invalid Request') {
            steps {
                echo "Roll No: ${ROLL_NO} - Testing error handling..."
                script {
                    def response = sh(script: '''
                        curl -s -X POST "http://localhost:${API_PORT}/predict" \
                        -H "Content-Type: application/json" \
                        -d '{"invalid": "data"}'
                    ''', returnStdout: true)
                    
                    echo "Error response: ${response}"
                    
                    // Should return an error
                    if (response.contains('error') || response.contains('Error') || response.contains('detail')) {
                        echo "Error handling test passed!"
                    } else {
                        echo "Response received - API handled request"
                    }
                }
            }
        }
        
        stage('Stop Container') {
            steps {
                echo "Roll No: ${ROLL_NO} - Stopping container..."
                sh '''
                    docker stop ${CONTAINER_NAME} || true
                    docker rm ${CONTAINER_NAME} || true
                '''
            }
        }
        
        stage('Pipeline Result') {
            steps {
                echo "Roll No: ${ROLL_NO} - All tests passed successfully!"
                echo "Inference validation completed for 2022BCS0016"
            }
        }
    }
    
    post {
        always {
            echo "Roll No: ${ROLL_NO} - Cleaning up..."
            sh 'docker stop ${CONTAINER_NAME} || true'
            sh 'docker rm ${CONTAINER_NAME} || true'
        }
        success {
            echo "========================================"
            echo "Lab 7 - Inference Validation: PASSED"
            echo "Roll No: 2022BCS0016"
            echo "========================================"
        }
        failure {
            echo "========================================"
            echo "Lab 7 - Inference Validation: FAILED"
            echo "Roll No: 2022BCS0016"
            echo "========================================"
        }
    }
}
